@page "/Processos"
@rendermode InteractiveServer

@using appwebGustavoMoreira.Models
@using appwebGustavoMoreira.DAO

@inject ProcessoDAO dao

<PageTitle>Processos - Sistema de Controle de Processos</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Consulta de Processos</h2>
    </div>

    <a href="/processos/cadastro" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i>
        Novo Processo
    </a>
</div>

<div class="custom-table-card">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Número</th>
                    <th>Interessado</th>
                    <th>Assunto</th>
                    <th>Situação</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @if (processos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            Nenhum processo cadastrado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in processos)
                    {
                        <tr>
                            <td>@p.Id</td>
                            <td>@p.Numero</td>
                            <td>@p.Interessado</td>
                            <td>@p.Assunto</td>
                            <td>@p.Situacao</td>

                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="@($"/processos/editar/{p.Id}")"
                                       class="btn btn-light border text-primary"
                                       title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a href="@($"/processos/excluir/{p.Id}")"
                                       class="btn btn-light border text-danger"
                                       title="Excluir">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<Processo> processos = new();

    protected override void OnInitialized()
    {
        processos = dao.Listar();
    }
}